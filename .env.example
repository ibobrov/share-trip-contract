# Local development only. Copy to .env and replace placeholders.
DATABASE_DSN=postgres://postgres:<password>@localhost:6545/sharetrip-contract?sslmode=disable

# Runtime configuration
HTTP_PORT=4002
REQUEST_TIMEOUT_MS=2000
LOG_LEVEL=INFO

# Local Docker Compose and migrations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DB=sharetrip-contract
POSTGRES_PORT=6545
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_DSN}
